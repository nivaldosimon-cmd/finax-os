{
  "colors": {
    "background": "#101012",
    "surface": "#161618",
    "surfaceHover": "#1e1e20",
    "primary": "#007BFF",
    "primaryLight": "#3395ff",
    "gold": "#D4AF37",
    "success": "#10B981",
    "danger": "#EF4444",
    "warning": "#F59E0B",
    "text": "#FFFFFF",
    "textSecondary": "#8E8E93",
    "border": "#2C2C2E"
  },
  "typography": {
    "fontFamily": "'Inter', 'Geist Sans', system-ui, sans-serif",
    "headings": {
      "h1": "2.5rem",
      "h2": "2rem",
      "h3": "1.5rem",
      "h4": "1.25rem"
    },
    "body": "0.9375rem"
  },
  "spacing": {
    "xs": "0.5rem",
    "sm": "1rem",
    "md": "1.5rem",
    "lg": "2rem",
    "xl": "3rem"
  },
  "borderRadius": {
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px"
  },
  "shadows": {
    "sm": "0 2px 8px rgba(0,0,0,0.2)",
    "md": "0 4px 16px rgba(0,0,0,0.3)",
    "lg": "0 8px 24px rgba(0,0,0,0.4)"
  },
  "animation": {
    "transition": "all 0.2s ease",
    "hoverScale": "scale(1.02)"
  }
}
